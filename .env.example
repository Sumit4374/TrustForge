# Copy to .env and fill passwords, or run ./start.sh to generate local credentials.
# .env is ignored. These are server settings: NEVER use VITE_ for a secret.
DB_USERNAME=trustforge
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/trustforge
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6380
CACHE_REDIS_PASSWORD=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@trustforge.local
MAILPIT_HTTP_PORT=8025
APP_BASE_URL=http://localhost:5173
APP_SECURE_COOKIES=false
# Provider remains unavailable until a real server-side key is configured.
BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_TIMEOUT=30
